{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2017", "DOM"],
    "paths": {
      "react": ["./node_modules/preact/compat"],
      "react-dom": ["./node_modules/preact/compat"]
    },
    "skipLibCheck": true
  },
  "include": [
    "../../node_modules/@figma/plugin-typings/index.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
