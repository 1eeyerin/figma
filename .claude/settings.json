{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; test -f \"$ROOT/.claude/hooks/docs-staleness-check.sh\" && bash \"$ROOT/.claude/hooks/docs-staleness-check.sh\"",
            "if": "Bash(git commit*)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; test -f \"$ROOT/.claude/hooks/auto-commit.sh\" && bash \"$ROOT/.claude/hooks/auto-commit.sh\""
          }
        ]
      }
    ]
  }
}
