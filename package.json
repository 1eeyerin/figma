{
  "name": "figma-bridge-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build:plugin": "pnpm --filter figma-bridge-plugin build",
    "watch:plugin": "pnpm --filter figma-bridge-plugin watch",
    "typecheck:plugin": "tsc -p figma-plugin/tsconfig.json",
    "dev:bridge": "pnpm --filter figma-bridge build && pnpm --filter figma-bridge start",
    "dev": "concurrently --names \"plugin,bridge\" --prefix-colors \"cyan,green\" \"pnpm run watch:plugin\" \"pnpm run dev:bridge\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.129.0",
    "concurrently": "^10.0.3",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.3"
  }
}
