if [ -n "$SKIP_PRE_PUSH" ]; then
  echo "⏭️  pre-push push hook을 스킵합니다."
  exit 0
fi

echo "🔨 빌드 실행 중..."
pnpm run build

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ 빌드 실패로 인해 push가 중단되었습니다."
  echo ""
  echo "다음 사항을 확인해주세요:"
  echo "  • 빌드 오류 메시지를 확인하여 문제를 해결해주세요"
  echo "  • TypeScript 타입 오류가 있는지 확인해주세요"
  echo "  • 모든 의존성이 올바르게 설치되었는지 확인해주세요 (pnpm install)"
  echo "  • 로컬에서 'pnpm run build'를 실행하여 오류를 확인해주세요"
  echo ""
  echo "💬 만약 의도적인 push라면 다음 명령어로 스킵할 수 있습니다:"
  echo "  SKIP_PRE_PUSH=1 git push"
  echo ""
  echo "문제를 해결한 후 다시 push를 시도해주세요."
  echo ""
  exit 1
fi

echo "✅ 빌드 성공"

echo "🧪 테스트 실행 중..."
pnpm run test

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ 테스트 실패로 인해 push가 중단되었습니다."
  echo ""
  echo "  • 로컬에서 'pnpm run test'를 실행하여 실패 내역을 확인해주세요"
  echo ""
  echo "💬 만약 의도적인 push라면 다음 명령어로 스킵할 수 있습니다:"
  echo "  SKIP_PRE_PUSH=1 git push"
  echo ""
  exit 1
fi

echo "✅ 테스트 통과"
