{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn"],
  "ignorePatterns": ["**/dist/**", "**/build/**", "**/*.module.css.d.ts"],
  "rules": {
    "no-unused-vars": "off",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-unused-expressions": "error",
    "no-duplicate-imports": "error",
    "import/newline-after-import": ["error", { "count": 1 }]
  },
  "overrides": [
    {
      "files": [
        "packages/figma-plugin/src/**/*.ts",
        "packages/figma-plugin/src/**/*.tsx"
      ],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["packages/figma-bridge-mcp/src/**/*.ts"],
      "env": {
        "node": true
      }
    }
  ]
}
